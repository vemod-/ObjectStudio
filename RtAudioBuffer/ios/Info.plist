<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Appens namn och identitet -->
    <key>CFBundleName</key>
    <string>objectstudio</string>
    <key>CFBundleDisplayName</key>
    <string>objectstudio</string>
    <key>CFBundleIdentifier</key>
    <string>Vemod.objectstudio</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>objectstudio</string>

    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconName</key>
            <string>AppIcon</string>
        </dict>
    </dict>

    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <!-- Ljudformat som stöds -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Wave file</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.microsoft.waveform-audio</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>wav</string>
                <string>wave</string>
            </array>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>AIFF file</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.aiff-audio</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>aif</string>
                <string>aiff</string>
            </array>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>MP3 file</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.mp3</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>mp3</string>
            </array>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>FLAC file</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.xiph.flac</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>flac</string>
            </array>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
        </dict>
    </array>

    <!-- iOS-behörigheter -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Den här appen behöver åtkomst till mikrofonen för att spela in ljud.</string>

    <!-- Filåtkomst -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>UISupportsDocumentBrowser</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!-- Orientering och UI -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>
    <key>UIRequiresFullScreen</key>
    <true/>
    <key>UIStatusBarHidden</key>
    <true/>
    <key>UIRequiresPersistentWiFi</key>
    <false/>
    <key>UIRequiresHighResolutionCapable</key>
    <true/>
</dict>
</plist>
